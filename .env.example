# Copy to .env.local and fill in. Everything is optional for the demo.

# Where data comes from: "memory" (default, seeded demo data) or "prisma"
DATA_SOURCE=memory

# Supabase PostgreSQL (needed when DATA_SOURCE=prisma)
DATABASE_URL=            # pooled connection string, used by the app
DIRECT_URL=              # direct connection, used by Prisma migrations

# Sign-in. With Supabase set, owners sign in with a 6-digit email code from Supabase Auth
# (the "Magic Link" email template must include {{ .Token }}). Without it, the demo store
# uses on-screen demo codes. See docs/AUTH.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AUTH_SECRET=                 # 32+ random characters; signs session and sign-up cookies. Required with DATA_SOURCE=prisma
ALLOW_DEMO=                  # "true" keeps /demo and demo codes available with DATA_SOURCE=prisma (staging only)

# Public base URL for links in WhatsApp messages and payment redirects
APP_URL=

# Deposits (see docs/ONLINE_BOOKING.md). Without keys the demo checkout is used.
PAYSTACK_SECRET_KEY=         # NGN deposits; also verifies Paystack webhooks
STRIPE_SECRET_KEY=           # USD deposits
STRIPE_WEBHOOK_SECRET=       # whsec_..., verifies Stripe webhooks
ALLOW_DEMO_PAYMENTS=         # "true" allows the demo checkout with DATA_SOURCE=prisma (staging only)

# WhatsApp Cloud API. Without these, messages are logged as SIMULATED, not sent.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=         # verifies webhook signatures
WHATSAPP_VERIFY_TOKEN=       # any string; enter the same one in the Meta webhook settings
WHATSAPP_TEMPLATE_LANGUAGE=en

# Scheduled reminders (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
