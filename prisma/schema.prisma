// Spa.Inc database schema (PostgreSQL via Supabase)
//
// Multi-tenant: every business record belongs to an Organization, and
// location-scoped records also carry a Location so Enterprise customers can
// run several branches. Money is stored as integer minor units (cents/kobo).
//
// Generate the client:   npm run db:generate
// Create a migration:    npm run db:migrate -- --name <change>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlanTier {
  ESSENTIALS
  MANAGER
  EXECUTIVE
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum Currency {
  USD
  NGN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum UserRole {
  ADMIN
  STAFF
}

enum AppointmentStatus {
  PENDING_DEPOSIT
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LocationType {
  IN_SPA
  REMOTE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum ExpenseCategory {
  SUPPLIES
  UTILITIES
  RENT
  PAYROLL
  EQUIPMENT
  MARKETING
  OTHER
}

enum RecurrenceInterval {
  DAILY
  WEEKLY
  MONTHLY
}

enum BookingSource {
  DASHBOARD
  ONLINE
}

enum DepositType {
  NONE
  FIXED
  PERCENT
}

enum DepositProvider {
  DEMO
  PAYSTACK
  STRIPE
}

enum DepositStatus {
  PENDING
  PAID
  REFUNDED
  FORFEITED
  EXPIRED
}

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum MessageKind {
  BOOKING_CONFIRMATION
  DEPOSIT_REQUEST
  REMINDER
  CANCELLATION
  REPLY
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  SIMULATED
  SENT
  FAILED
  RECEIVED
}

enum SalesLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

// ---------------------------------------------------------------------------
// Tenancy & billing
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  countryCode String   @default("US") @map("country_code") @db.Char(2)
  /// Currency the business charges in (deposits, booking page)
  currency    Currency @default(USD)
  /// The demo business (its plan comes from the demo cookie)
  isDemo      Boolean  @default(false) @map("is_demo")
  /// Onboarding checklist progress (the other steps are derived from data)
  onboardingLinkSharedAt DateTime? @map("onboarding_link_shared_at")
  onboardingDismissedAt  DateTime? @map("onboarding_dismissed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscription    Subscription?
  bookingSettings BookingSettings?
  deposits        Deposit[]
  messages        Message[]
  locations    Location[]
  users        User[]
  clients      Client[]
  services     Service[]
  appointments Appointment[]
  payments     Payment[]
  expenses     Expense[]

  @@map("organizations")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @map("organization_id") @db.Uuid
  plan               PlanTier
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY) @map("billing_cycle")
  currency           Currency           @default(USD)
  /// Price per billing cycle in minor units; null for custom Enterprise quotes
  amountMinor        Int?               @map("amount_minor")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  /// Add-on ids from src/lib/pricing.ts
  addOns             String[]           @default([]) @map("add_ons")
  providerCustomerId String?            @map("provider_customer_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Public booking page configuration (one row per organization)
model BookingSettings {
  organizationId          String      @id @map("organization_id") @db.Uuid
  enabled                 Boolean     @default(true)
  depositType             DepositType @default(NONE) @map("deposit_type")
  /// Minor units for FIXED, whole percent for PERCENT
  depositValue            Int         @default(0) @map("deposit_value")
  cancellationNoticeHours Int         @default(24) @map("cancellation_notice_hours")
  holdMinutes             Int         @default(30) @map("hold_minutes")
  remindersEnabled        Boolean     @default(true) @map("reminders_enabled")
  reminderHoursBefore     Int         @default(24) @map("reminder_hours_before")
  minNoticeMinutes        Int         @default(120) @map("min_notice_minutes")
  bookingWindowDays       Int         @default(30) @map("booking_window_days")
  welcomeMessage          String      @default("") @map("welcome_message")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("booking_settings")
}

model Location {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  address        String?
  phone          String?
  timezone       String   @default("UTC")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  appointments Appointment[]
  expenses     Expense[]

  @@index([organizationId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  /// Supabase auth.users.id, linked on first sign-in (invited staff exist before they sign in)
  authUserId     String?  @unique @map("auth_user_id")
  email          String   @unique
  fullName       String   @map("full_name")
  role           UserRole
  phone          String?
  avatarUrl      String?  @map("avatar_url")
  isActive       Boolean  @default(true) @map("is_active")
  /// Takes bookings: therapists, and owners who also do treatments
  isBookable     Boolean  @default(false) @map("is_bookable")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location        Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  appointments    Appointment[]
  payments        Payment[]
  schedules       StaffSchedule[]
  createdExpenses Expense[]

  @@index([organizationId, role])
  @@map("users")
}

model Client {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  fullName       String    @map("full_name")
  email          String?
  phone          String?
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  address        String?
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  payments     Payment[]
  deposits     Deposit[]
  messages     Message[]

  @@index([organizationId, fullName])
  @@index([organizationId, phone])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model Service {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  name                   String
  description            String?
  defaultDurationMinutes Int      @map("default_duration_minutes")
  defaultPrice           Int      @map("default_price")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([organizationId])
  @@map("services")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  locationId         String?           @map("location_id") @db.Uuid
  clientId           String            @map("client_id") @db.Uuid
  staffId            String            @map("staff_id") @db.Uuid
  serviceId          String            @map("service_id") @db.Uuid
  scheduledAt        DateTime          @map("scheduled_at")
  durationMinutes    Int               @map("duration_minutes")
  status             AppointmentStatus @default(SCHEDULED)
  locationType       LocationType      @default(IN_SPA) @map("location_type")
  locationNotes      String?           @map("location_notes")
  satisfactionRating Int?              @map("satisfaction_rating") @db.SmallInt
  notes              String?
  source             BookingSource     @default(DASHBOARD)
  /// While PENDING_DEPOSIT, the slot is released after this instant
  holdExpiresAt      DateTime?         @map("hold_expires_at")
  confirmedAt        DateTime?         @map("confirmed_at")
  reminderSentAt     DateTime?         @map("reminder_sent_at")
  /// Secret for the client's manage-booking link
  manageToken        String?           @unique @map("manage_token")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff        User         @relation(fields: [staffId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  payments     Payment[]
  deposits     Deposit[]
  messages     Message[]

  @@index([organizationId, scheduledAt])
  @@index([staffId, scheduledAt])
  @@index([clientId])
  @@map("appointments")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  appointmentId  String?       @map("appointment_id") @db.Uuid
  clientId       String        @map("client_id") @db.Uuid
  staffId        String        @map("staff_id") @db.Uuid
  amount         Int
  paymentMethod  PaymentMethod @map("payment_method")
  paymentDate    DateTime      @map("payment_date") @db.Date
  status         PaymentStatus @default(COMPLETED)
  referenceNote  String?       @map("reference_note")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff        User         @relation(fields: [staffId], references: [id])

  @@index([organizationId, paymentDate])
  @@index([staffId, paymentDate])
  @@map("payments")
}

model Expense {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  locationId         String?             @map("location_id") @db.Uuid
  category           ExpenseCategory
  description        String
  amount             Int
  expenseDate        DateTime            @map("expense_date") @db.Date
  isRecurring        Boolean             @default(false) @map("is_recurring")
  recurrenceInterval RecurrenceInterval? @map("recurrence_interval")
  receiptUrl         String?             @map("receipt_url")
  createdById        String              @map("created_by") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId, expenseDate])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Online booking: deposits and client messages
// ---------------------------------------------------------------------------

model Deposit {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  appointmentId     String          @map("appointment_id") @db.Uuid
  clientId          String          @map("client_id") @db.Uuid
  /// Minor units in `currency`
  amount            Int
  currency          Currency
  provider          DepositProvider
  status            DepositStatus   @default(PENDING)
  /// Paystack reference or Stripe Checkout session id
  providerReference String          @unique @map("provider_reference")
  checkoutUrl       String?         @map("checkout_url")
  paymentId         String?         @unique @map("payment_id") @db.Uuid
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([appointmentId])
  @@map("deposits")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  appointmentId     String?          @map("appointment_id") @db.Uuid
  clientId          String?          @map("client_id") @db.Uuid
  channel           MessageChannel
  kind              MessageKind
  direction         MessageDirection
  /// E.164 digits for WhatsApp/SMS, an address for email
  to                String
  body              String
  status            MessageStatus
  providerMessageId String?          @map("provider_message_id")
  error             String?
  createdAt         DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([to, direction, createdAt])
  @@map("messages")
}

model StaffSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week") @db.SmallInt // 0 = Sunday
  startTime   String   @map("start_time") // "09:00"
  endTime     String   @map("end_time")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@map("staff_schedules")
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

/// Enquiries from the public /contact-sales form (not tenant-scoped)
model SalesLead {
  id           String          @id @default(uuid()) @db.Uuid
  fullName     String          @map("full_name")
  email        String
  phone        String
  businessName String          @map("business_name")
  plan         PlanTier
  locations    String
  staffCount   String          @map("staff_count")
  addOns       String[]        @default([]) @map("add_ons")
  message      String?
  countryCode  String?         @map("country_code") @db.Char(2)
  status       SalesLeadStatus @default(NEW)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("sales_leads")
}
