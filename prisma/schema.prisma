// Spa.Inc database schema (PostgreSQL via Supabase)
//
// Multi-tenant: every business record belongs to an Organization, and
// location-scoped records also carry a Location so Enterprise customers can
// run several branches. Money is stored as integer minor units (cents/kobo).
//
// Generate the client:   npm run db:generate
// Create a migration:    npm run db:migrate -- --name <change>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlanTier {
  ESSENTIALS
  MANAGER
  EXECUTIVE
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum Currency {
  USD
  NGN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum UserRole {
  ADMIN
  STAFF
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LocationType {
  IN_SPA
  REMOTE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum ExpenseCategory {
  SUPPLIES
  UTILITIES
  RENT
  PAYROLL
  EQUIPMENT
  MARKETING
  OTHER
}

enum RecurrenceInterval {
  DAILY
  WEEKLY
  MONTHLY
}

enum SalesLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

// ---------------------------------------------------------------------------
// Tenancy & billing
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  countryCode String   @default("US") @map("country_code") @db.Char(2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscription Subscription?
  locations    Location[]
  users        User[]
  clients      Client[]
  services     Service[]
  appointments Appointment[]
  payments     Payment[]
  expenses     Expense[]

  @@map("organizations")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @map("organization_id") @db.Uuid
  plan               PlanTier
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY) @map("billing_cycle")
  currency           Currency           @default(USD)
  /// Price per billing cycle in minor units; null for custom Enterprise quotes
  amountMinor        Int?               @map("amount_minor")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  /// Add-on ids from src/lib/pricing.ts
  addOns             String[]           @default([]) @map("add_ons")
  providerCustomerId String?            @map("provider_customer_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Location {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  address        String?
  phone          String?
  timezone       String   @default("UTC")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  appointments Appointment[]
  expenses     Expense[]

  @@index([organizationId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  id             String   @id @db.Uuid // matches Supabase auth.users.id
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  email          String   @unique
  fullName       String   @map("full_name")
  role           UserRole
  phone          String?
  avatarUrl      String?  @map("avatar_url")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location        Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  appointments    Appointment[]
  payments        Payment[]
  schedules       StaffSchedule[]
  createdExpenses Expense[]

  @@index([organizationId, role])
  @@map("users")
}

model Client {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  fullName       String    @map("full_name")
  email          String?
  phone          String?
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  address        String?
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  payments     Payment[]

  @@index([organizationId, fullName])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model Service {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  name                   String
  description            String?
  defaultDurationMinutes Int      @map("default_duration_minutes")
  defaultPrice           Int      @map("default_price")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([organizationId])
  @@map("services")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  locationId         String?           @map("location_id") @db.Uuid
  clientId           String            @map("client_id") @db.Uuid
  staffId            String            @map("staff_id") @db.Uuid
  serviceId          String            @map("service_id") @db.Uuid
  scheduledAt        DateTime          @map("scheduled_at")
  durationMinutes    Int               @map("duration_minutes")
  status             AppointmentStatus @default(SCHEDULED)
  locationType       LocationType      @default(IN_SPA) @map("location_type")
  locationNotes      String?           @map("location_notes")
  satisfactionRating Int?              @map("satisfaction_rating") @db.SmallInt
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff        User         @relation(fields: [staffId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  payments     Payment[]

  @@index([organizationId, scheduledAt])
  @@index([staffId, scheduledAt])
  @@index([clientId])
  @@map("appointments")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  appointmentId  String?       @map("appointment_id") @db.Uuid
  clientId       String        @map("client_id") @db.Uuid
  staffId        String        @map("staff_id") @db.Uuid
  amount         Int
  paymentMethod  PaymentMethod @map("payment_method")
  paymentDate    DateTime      @map("payment_date") @db.Date
  status         PaymentStatus @default(COMPLETED)
  referenceNote  String?       @map("reference_note")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff        User         @relation(fields: [staffId], references: [id])

  @@index([organizationId, paymentDate])
  @@index([staffId, paymentDate])
  @@map("payments")
}

model Expense {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  locationId         String?             @map("location_id") @db.Uuid
  category           ExpenseCategory
  description        String
  amount             Int
  expenseDate        DateTime            @map("expense_date") @db.Date
  isRecurring        Boolean             @default(false) @map("is_recurring")
  recurrenceInterval RecurrenceInterval? @map("recurrence_interval")
  receiptUrl         String?             @map("receipt_url")
  createdById        String              @map("created_by") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId, expenseDate])
  @@map("expenses")
}

model StaffSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week") @db.SmallInt // 0 = Sunday
  startTime   String   @map("start_time") // "09:00"
  endTime     String   @map("end_time")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@map("staff_schedules")
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

/// Enquiries from the public /contact-sales form (not tenant-scoped)
model SalesLead {
  id           String          @id @default(uuid()) @db.Uuid
  fullName     String          @map("full_name")
  email        String
  phone        String
  businessName String          @map("business_name")
  plan         PlanTier
  locations    String
  staffCount   String          @map("staff_count")
  addOns       String[]        @default([]) @map("add_ons")
  message      String?
  countryCode  String?         @map("country_code") @db.Char(2)
  status       SalesLeadStatus @default(NEW)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("sales_leads")
}
